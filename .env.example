# Copy to .env for local use, or add these in Render > Environment. NEVER commit real values.
PROVIDER_API_KEY=your-cheapsmmmarket-api-key
PROVIDER_API_URL=https://cheapsmmmarket.com/api/v2
ADMIN_EMAIL=you@example.com

# Exact site(s) that may call this API, comma separated, no path (www/non-www both work)
ALLOWED_ORIGINS=https://your-site.example

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the whole downloaded JSON file contents as ONE value (or base64 of it in FIREBASE_SERVICE_ACCOUNT_B64).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

CRON_SECRET=change-me-to-a-long-random-string

# 90 if provider prices are in USD and you sell in INR; 0 to disable suggestions
PROVIDER_CURRENCY_TO_INR=0
DEFAULT_MARKUP_PERCENT=30
