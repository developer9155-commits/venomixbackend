# Copy these into Render > Environment (never commit real values)
PROVIDER_API_KEY=your_cheapsmmmarket_api_key
PROVIDER_API_URL=https://cheapsmmmarket.com/api/v2
ADMIN_EMAIL=developer9692@gmail.com
# Your website origin(s), comma separated, no trailing slash
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on ONE line (or use FIREBASE_SERVICE_ACCOUNT_B64 with base64 of the file).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"venomixsmm",...}
# Long random string used by the cron pinger: /api/cron/sync?token=THIS
CRON_SECRET=change-me-to-a-long-random-string
# Optional: if provider prices are in USD, set rate so the admin panel can show cost and a suggested price in INR
PROVIDER_CURRENCY_TO_INR=0
DEFAULT_MARKUP_PERCENT=30
